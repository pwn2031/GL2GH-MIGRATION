#!/usr/bin/env bash

# ----------------------------
# Paths
# ----------------------------
export WORKSPACE_DIR="$HOME/GL2GH-MIGRATION"
export INPUTS_DIR="$WORKSPACE_DIR/inputs"
export INVENTORY_DIR="$WORKSPACE_DIR/inventory"
export MIGRATION_DIR="$WORKSPACE_DIR/migration"
export REPORTS_DIR="$WORKSPACE_DIR/reports"
export LOG_DIR="$WORKSPACE_DIR/logs"
export WORKING_CLONES_DIR="$WORKSPACE_DIR/working-clones"

# ============================================================
# GitLab to GitHub Migration Automation - Configuration
# ============================================================

# ----------------------------
# GitLab configuration
# ----------------------------
export GITLAB_URL=https://gitlab.com
export GITLAB_TOKEN=<glpat-token>
export GITLAB_GROUP=migration-poc1
export GITLAB_ADMIN_TOKEN=<glpat-token>

# GitLab root group used for team discovery -change accordingly
export GITLAB_TEAM_ROOT_GROUPS=<"devops-team7754944,migration-poc1">

# ----------------------------
# GitHub configuration
# ----------------------------

# GitHub authenticated user-change accordingly
export GITHUB_USER=<"pwn2031">
export GITHUB_TOKEN=<ghp_token>

# GitHub organization destination-change accordingly
export GITHUB_ORG=<"GL-GHMigration">
export GITHUB_ACCOUNT=<"GL-GHMigration">
export GITHUB_TARGET_MODE=<"organization">

# GitHub organization-change accordingly

export GITHUB_ACCOUNT=<"GL-GHMigration">
export GITHUB_ORG=<"GL-GHMigration">
export GITHUB_TARGET_MODE=<"organization">

# Automatic GitLab group-to-GitHub team conversion
export GITLAB_TEAM_SOURCE="full_group_tree"
export GITHUB_TEAM_PREFIX=""
export GITHUB_TEAM_PRIVACY="closed"
export INCLUDE_EMPTY_GITLAB_GROUPS="true"
export DEFAULT_GITHUB_TEAM_PERMISSION="pull"



# ----------------------------
# Identity mapping - change mapping file accordingly
# ----------------------------
export IDENTITY_MAPPING_FILE="$WORKSPACE_DIR/inputs/identity-mapping.csv"

# ----------------------------
# Migration controls
# ----------------------------
# true  = generate inventory/plans only, do not change GitHub
# false = perform actual migration
export DRY_RUN="false"

# true  = run all steps without pausing
# false = pause after migration plan for review
export AUTO_APPROVE="false"

# true  = stop immediately on first failure
# false = continue and record failures
export FAIL_FAST="true"

# fail = stop if a GitLab member has no GitHub mapping
# skip = skip unmapped users and record them
export UNMAPPED_USER_POLICY="skip"

# ----------------------------
# Branch protection
# ----------------------------
export DEFAULT_BRANCH="main"
export PROTECT_DEFAULT_BRANCH="true"
export REQUIRE_PULL_REQUEST="true"
export REQUIRED_APPROVALS="1"

# ----------------------------
# Runners
# ----------------------------
export GITHUB_HOSTED_RUNNER="ubuntu-latest"
export EC2_RUNNER_LABEL="ec2"



# ----------------------------
# GitHub CLI automation
# ----------------------------
export GH_TOKEN="$GITHUB_TOKEN"
export GH_HOST="github.com"